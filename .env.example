# Optional. When set, the voice desk uses OpenAI Realtime (voice marin)
# and typed replies can use Chat Completions. Without it, typed turns use
# the keyword planner. The desk does not fall back to browser speech.
OPENAI_API_KEY=
# Text brain for /api/chat. gpt-5.1 is not a Realtime speech model.
OPENAI_MODEL=gpt-5.1
# Speech-to-speech model. 2026 Realtime docs pair this id with voice marin.
# If the API rejects it, the token endpoint tries gpt-realtime, then gpt-live-1.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# HTTP port (Fly.io sets PORT for you)
PORT=3000

# SQLite file. Defaults to data/maison-sol.sqlite. On Fly, both apps mount a volume
# at /data and set DATABASE_PATH=/data/maison-sol.sqlite (agents_data on Agents,
# telephony_data on telephony) so agents/knowledge/calls and purchased numbers
# survive restarts/deploys. Without a volume the file is lost.
# DATABASE_PATH=/data/maison-sol.sqlite

# Telephony console. When BOTH are set, /console lists numbers and calls
# from the Twilio REST API. When either is empty, the console stays in Demo
# mode and uses SQLite. Never commit real values. Secrets are not returned
# to the browser.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional. The live client authenticates with the Account SID and Auth Token.
# The API key can be stored for the Account page; the secret is never echoed.
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=

# Product split. "all" (default) serves Agents + nested /console on one host.
# "agents" serves the Voice Desk and 302-redirects /console to TELEPHONY_PUBLIC_URL.
# "telephony" serves only the demo Twilio console at / on its own hostname.
SERVICE=all
# Absolute public URL of the telephony Fly app (no trailing slash).
TELEPHONY_PUBLIC_URL=
# Absolute public URL of the agents Fly app (used by telephony → Agents switcher).
AGENTS_PUBLIC_URL=
# Absolute public URL of THIS host (Agents advertises Stream wss://… from this).
# On Fly, defaults to https://$FLY_APP_NAME.fly.dev when unset.
PUBLIC_URL=

# Optional. When set on BOTH apps, Agents must send it as X-Telephony-Secret
# when fetching GET /api/public/phone-numbers from telephony. Leave empty for
# an open demo list (default). Never commit a real value.
TELEPHONY_SHARED_SECRET=

# Accounts use HttpOnly cookies (vd_session). No extra env required for local demo.
# On split Fly deploys, set the same TELEPHONY_SHARED_SECRET on both apps so signup
# on Agents can mirror the tenant onto telephony (empty numbers until that tenant buys).
