# Optional. When set, the voice desk uses OpenAI Realtime (voice marin)
# and typed fallback replies use Chat Completions. Without it, the desk
# uses browser speech plus a keyword planner and the same tools.
OPENAI_API_KEY=
# Text brain for /api/chat. gpt-5.1 is not a Realtime speech model.
OPENAI_MODEL=gpt-5.1
# Speech-to-speech model. 2026 Realtime docs pair this id with voice marin.
# If the API rejects it, the token endpoint tries gpt-realtime, then gpt-live-1.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# HTTP port (Fly.io sets PORT for you)
PORT=3000
