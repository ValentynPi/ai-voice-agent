{
  "name": "ai-voice-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Voice Desk control plane for Maison Sol. OpenAI Realtime voice marin, agents and call history in SQLite, web test calls. No Twilio.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "DATABASE_PATH=:memory: NODE_ENV=test node --disable-warning=ExperimentalWarning --test --test-concurrency=1"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
